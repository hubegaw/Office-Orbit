# =============================================================================
# OFFICE ORBIT - Environment Variables Template
# =============================================================================
# Copy this file to .env and customize for your local environment
# Never commit .env to git!

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
DB_NAME=officeorbit
DB_USER=admin
DB_PASSWORD=changeme_in_production
DB_HOST=postgres
DB_PORT=5432

# Connection string (auto-generated, don't change unless needed)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# =============================================================================
# MONITORING - Prometheus
# =============================================================================
PROMETHEUS_PORT=9090

# Retention period (how long to keep metrics)
PROMETHEUS_RETENTION=15d

# =============================================================================
# MONITORING - Grafana
# =============================================================================
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Change this in production!
# Use strong password generator: openssl rand -base64 32
GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_PASSWORD}

# =============================================================================
# MONITORING - PostgreSQL Exporter
# =============================================================================
POSTGRES_EXPORTER_PORT=9187

# =============================================================================
# BACKEND - Quarkus Application
# =============================================================================
QUARKUS_HTTP_PORT=8080
QUARKUS_PROFILE=dev

# JWT Secret (generate new one: openssl rand -base64 64)
JWT_SECRET=changeme_generate_random_secret_in_production

# JWT expiration (in seconds)
JWT_EXPIRATION=3600

# =============================================================================
# FRONTEND - Angular Application
# =============================================================================
ANGULAR_PORT=4200

# API URL (where frontend calls backend)
API_BASE_URL=http://localhost:${QUARKUS_HTTP_PORT}

# =============================================================================
# SECURITY - Keycloak (Optional, for later)
# =============================================================================
# KEYCLOAK_URL=http://localhost:8180
# KEYCLOAK_REALM=office-orbit
# KEYCLOAK_CLIENT_ID=office-orbit-app
# KEYCLOAK_CLIENT_SECRET=changeme

# =============================================================================
# OBSERVABILITY - OpenTelemetry (Optional, for later)
# =============================================================================
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=office-orbit-backend

# =============================================================================
# DOCKER COMPOSE
# =============================================================================
# Project name (affects container and network names)
COMPOSE_PROJECT_NAME=office-orbit

# =============================================================================
# DEVELOPMENT
# =============================================================================
# Log level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# Enable debug mode
DEBUG=false

# Enable hot reload
HOT_RELOAD=true